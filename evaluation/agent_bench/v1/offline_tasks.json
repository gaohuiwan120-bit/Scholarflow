      "id": "off-01",
      "title": "Paper research evidence extraction",
      "entry": "api_task",
      "kind": "paper_research",
      "data_mode": "fixture",
      "input": {
        "question": "Blended RAG hybrid dense sparse vs Naive RAG",
        "persist_artifacts": true
      },
      "expect_outcome": "succeeded",
