# ScholarFlow local demo — copy to `.env` and fill secrets.
# Never put secrets into VITE_* / frontend build vars.

# DeepSeek — https://platform.deepseek.com (chat / research LLM)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ScholarFlow LLM overrides (optional)
# SCHOLARFLOW_LLM_MODEL=deepseek-chat
# SCHOLARFLOW_LLM_BASE_URL=https://api.deepseek.com
# SCHOLARFLOW_LLM_TIMEOUT=60
# SCHOLARFLOW_LLM_MAX_RETRIES=2
# SCHOLARFLOW_LLM_TEMPERATURE=0.2
# SCHOLARFLOW_CHAT_MAX_TOOL_ITERS=8
# SCHOLARFLOW_CONVERSATIONS_DIR=
# SCHOLARFLOW_TASKS_DIR=

# GitHub — live repository search (authenticated quota)
# GITHUB_TOKEN=ghp_your_token

# Optional ScholarFlow paths (normally set by start scripts)
# SCHOLAR_MCP_DIR=
# SCHOLAR_HARNESS_DIR=

# Optional search providers (only if you enable those tools)
# SERPER_API_KEY=
# TAVILY_API_KEY=
# JINA_API_KEY=
